<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<%
    const reportTodayPaidTotal = typeof todayPaidTotal !== 'undefined'
        ? todayPaidTotal
        : (typeof todayTotals !== 'undefined' && todayTotals ? todayTotals.feesPaid : 0);
    const reportMonthlyPaidTotal = typeof monthlyPaidTotal !== 'undefined'
        ? monthlyPaidTotal
        : (typeof monthlyTotals !== 'undefined' && monthlyTotals ? monthlyTotals.feesPaid : 0);
    const reportSelectedDate = typeof selectedDate !== 'undefined'
        ? selectedDate
        : new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Asia/Kolkata',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        }).format(new Date());
%>

<main class="main-content">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Fee Collection</h2>
            <p class="text-muted mb-0">Registration payments by application date (India time)</p>
        </div>
        <a class="btn btn-outline-secondary" href="/">
            <i class="fas fa-arrow-left me-2"></i>Dashboard
        </a>
    </div>

    <form method="GET" action="/day1" class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label fw-semibold" for="date">Collection date</label>
                    <input class="form-control" type="date" id="date" name="date"
                        value="<%= reportSelectedDate %>" required>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label fw-semibold" for="month">Report month</label>
                    <input class="form-control" type="month" id="month" name="month"
                        value="<%= selectedMonth %>" required>
                </div>
                <% if (branches.length > 1) { %>
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label fw-semibold" for="branch">Branch</label>
                        <select class="form-select" id="branch" name="branch">
                            <option value="">All branches</option>
                            <% branches.forEach(branch => { %>
                                <option value="<%= branch %>" <%= selectedBranch === branch ? 'selected' : '' %>>
                                    <%= branch.charAt(0).toUpperCase() + branch.slice(1) %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                <% } else { %>
                    <input type="hidden" name="branch" value="<%= selectedBranch %>">
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label fw-semibold">Branch</label>
                        <div class="form-control bg-light">
                            <%= selectedBranch.charAt(0).toUpperCase() + selectedBranch.slice(1) %>
                        </div>
                    </div>
                <% } %>
                <div class="col-lg-4">
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-filter me-2"></i>Show report
                    </button>
                </div>
            </div>
        </div>
    </form>

    <section class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <button class="btn btn-link text-decoration-none text-start text-dark fw-bold p-0"
                type="button" data-bs-toggle="collapse" data-bs-target="#todayPayments"
                aria-expanded="false" aria-controls="todayPayments">
                <i class="fas fa-chevron-right me-2"></i>Collection
                <span class="text-muted fs-6">(<%= reportSelectedDate %>)</span>
                <span class="small text-primary ms-2">Click to see paid and unpaid fees</span>
            </button>
        </div>
        <div class="card-body px-4">
            <div class="bg-light rounded-3 p-3 mb-3">
                <div class="small text-muted">Paid fees collected on selected date</div>
                <div class="fs-4 fw-bold text-success">₹<%= Number(reportTodayPaidTotal || 0).toFixed(2) %></div>
            </div>
            <div class="collapse" id="todayPayments">
                <div class="pt-2">
                    <h6 class="fw-semibold mb-3">Student fee details for <%= reportSelectedDate %></h6>
                    <%- include('partials/fee-collection-rows', { applications: todayApplications }) %>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="fw-bold mb-0">Monthly Collection: <%= selectedMonth %></h5>
        </div>
        <div class="card-body px-4">
            <div class="bg-light rounded-3 p-3">
                <div class="small text-muted">Paid fees collected this month</div>
                <div class="fs-4 fw-bold text-success">₹<%= Number(reportMonthlyPaidTotal || 0).toFixed(2) %></div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
