<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f7f5ef">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            color-scheme: light;
            font-family: 'Outfit', sans-serif;
            color: #292a27;
            background: #f7f5ef;
            font-synthesis: none;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            --ink: #292a27;
            --gold: #d3a52c;
            --gold-deep: #a77a12;
            --muted: #74736d;
            --border: #e7e4dc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-width: 320px;
            min-height: 100vh;
            min-height: 100svh;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 38px 20px 24px;
            background:
                radial-gradient(ellipse at 8% 8%, rgba(211, 165, 44, 0.09), transparent 30%),
                radial-gradient(ellipse at 94% 90%, rgba(65, 62, 53, 0.035), transparent 34%),
                #f7f5ef;
        }

        .application-shell {
            width: min(100%, 760px);
            margin: auto;
        }

        .application-card {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(231, 228, 220, 0.95);
            border-radius: 22px;
            background: #fff;
            box-shadow: 0 24px 70px rgba(48, 43, 30, 0.1), 0 3px 12px rgba(48, 43, 30, 0.035);
            animation: enter 420ms ease-out both;
        }

        .application-header {
            position: relative;
            display: flex;
            min-height: 166px;
            align-items: center;
            gap: 24px;
            overflow: hidden;
            padding: 30px 38px;
            color: var(--ink);
            background:
                radial-gradient(ellipse at 92% 10%, rgba(211, 165, 44, 0.13), transparent 34%),
                linear-gradient(115deg, #fffefa 0%, #fbf8ef 100%);
        }

        .application-header::before,
        .application-header::after {
            position: absolute;
            content: "";
            border: 1px solid rgba(167, 122, 18, 0.12);
            border-radius: 50%;
            pointer-events: none;
        }

        .application-header::before {
            width: 280px;
            height: 280px;
            top: -190px;
            right: -40px;
        }

        .application-header::after {
            width: 190px;
            height: 190px;
            right: 110px;
            bottom: -155px;
        }

        .brand-logo {
            position: relative;
            z-index: 1;
            display: block;
            width: min(205px, 30vw);
            height: auto;
            flex: 0 0 auto;
            object-fit: contain;
        }

        .header-copy {
            position: relative;
            z-index: 1;
        }

        .header-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: var(--gold-deep);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

        .header-eyebrow::before {
            width: 20px;
            height: 2px;
            content: "";
            background: var(--gold);
        }

        .header-copy h1 {
            margin: 0;
            font-size: clamp(1.55rem, 3.2vw, 2rem);
            font-weight: 700;
            letter-spacing: -0.035em;
            line-height: 1.15;
        }

        .header-copy p {
            margin: 8px 0 0;
            color: #6f6b60;
            font-size: 0.91rem;
            line-height: 1.5;
        }

        .application-body {
            padding: 30px 38px 34px;
        }

        .form-intro {
            margin: 0 0 25px;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .form-alert {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            margin: 0 0 24px;
            padding: 13px 15px;
            border: 1px solid #fecaca;
            border-radius: 11px;
            color: #991b1b;
            background: #fff1f2;
            font-size: 0.9rem;
            line-height: 1.45;
        }

        .form-alert i {
            margin-top: 2px;
        }

        .form-section + .form-section {
            margin-top: 27px;
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0 0 17px;
            color: var(--ink);
            font-size: 0.97rem;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .section-number {
            display: grid;
            width: 30px;
            height: 30px;
            flex: 0 0 30px;
            place-items: center;
            border-radius: 9px;
            color: var(--ink);
            background: #fff3cc;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .section-heading::after {
            height: 1px;
            flex: 1;
            content: "";
            background: var(--border);
        }

        .field-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .field {
            min-width: 0;
        }

        .field-full {
            grid-column: 1 / -1;
        }

        .field label {
            display: block;
            margin-bottom: 7px;
            color: #41413c;
            font-size: 0.84rem;
            font-weight: 600;
        }

        .required-mark {
            color: var(--gold-deep);
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap > i {
            position: absolute;
            top: 50%;
            left: 14px;
            color: #85837b;
            font-size: 0.9rem;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .field-control {
            display: block;
            width: 100%;
            min-height: 49px;
            border: 1px solid var(--border);
            border-radius: 10px;
            outline: none;
            color: #292a27;
            background-color: #fff;
            font: inherit;
            font-size: 0.91rem;
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }

        .input-wrap .field-control {
            padding: 0 14px 0 41px;
        }

        .field-control::placeholder {
            color: #98a2b3;
        }

        .field-control:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 4px rgba(211, 165, 44, 0.15);
        }

        textarea.field-control {
            min-height: 105px;
            resize: vertical;
            padding: 13px 14px 13px 41px;
            line-height: 1.5;
        }

        .input-wrap:has(textarea) > i {
            top: 17px;
            transform: none;
        }

        .field select.field-control {
            appearance: none;
            padding: 0 40px 0 41px;
            cursor: pointer;
        }

        .select-wrap::after {
            position: absolute;
            top: 50%;
            right: 15px;
            color: #85837b;
            content: "\f078";
            font-family: "Font Awesome 6 Free";
            font-size: 0.72rem;
            font-weight: 900;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .submit-area {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-top: 27px;
            padding-top: 22px;
            border-top: 1px solid #edf0f5;
        }

        .submit-note {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--muted);
            font-size: 0.8rem;
            line-height: 1.45;
        }

        .submit-note i {
            color: var(--gold-deep);
        }

        .submit-button,
        .success-button {
            display: inline-flex;
            min-height: 50px;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 12px 22px;
            border: 0;
            border-radius: 10px;
            color: #292a27;
            background: var(--gold);
            box-shadow: 0 7px 16px rgba(167, 122, 18, 0.2);
            font: inherit;
            font-size: 0.9rem;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
        }

        .submit-button:hover,
        .success-button:hover {
            background: #e1b641;
            box-shadow: 0 10px 22px rgba(167, 122, 18, 0.24);
            transform: translateY(-1px);
        }

        .submit-button:focus-visible,
        .success-button:focus-visible {
            outline: 3px solid rgba(167, 122, 18, 0.35);
            outline-offset: 3px;
        }

        .application-footer {
            margin-top: 17px;
            color: #7b879a;
            font-size: 0.76rem;
            text-align: center;
        }

        .success-content {
            display: flex;
            min-height: 390px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 44px 38px;
            text-align: center;
        }

        .success-icon {
            display: grid;
            width: 72px;
            height: 72px;
            place-items: center;
            margin-bottom: 20px;
            border-radius: 50%;
            color: #16794b;
            background: #e9f8ef;
            font-size: 1.8rem;
        }

        .success-content h2 {
            margin: 0;
            color: var(--ink);
            font-size: 1.65rem;
            letter-spacing: -0.03em;
        }

        .success-content p {
            max-width: 430px;
            margin: 10px 0 0;
            color: var(--muted);
            font-size: 0.93rem;
            line-height: 1.6;
        }

        .application-id {
            margin: 20px 0 24px;
            border: 1px solid #ead9a5;
            border-radius: 9px;
            background: #fcf8ec;
            color: var(--ink);
            font-size: 0.9rem;
            font-weight: 700;
            padding: 11px 16px;
        }

        @keyframes enter {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
            body {
                justify-content: flex-start;
                padding: 18px 13px 20px;
            }

            .application-card {
                border-radius: 17px;
            }

            .application-header {
                min-height: 0;
                align-items: flex-start;
                flex-direction: column;
                gap: 18px;
                padding: 23px 21px 24px;
            }

            .brand-logo {
                width: min(184px, 72vw);
            }

            .header-copy p {
                font-size: 0.86rem;
            }

            .application-body {
                padding: 23px 20px 24px;
            }

            .field-grid {
                grid-template-columns: minmax(0, 1fr);
                gap: 14px;
            }

            .field-full {
                grid-column: auto;
            }

            .form-section + .form-section {
                margin-top: 23px;
            }

            .submit-area {
                align-items: stretch;
                flex-direction: column;
                gap: 15px;
            }

            .submit-button {
                width: 100%;
            }

            .success-content {
                min-height: 350px;
                padding: 36px 22px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>
    <% const applicationFormData = typeof formData === 'undefined' || !formData ? {} : formData; %>
    <main class="application-shell">
        <section class="application-card" aria-labelledby="application-title">
            <header class="application-header">
                <img class="brand-logo" src="/logo.png" alt="Creative Web Infotech">
                <div class="header-copy">
                    <div class="header-eyebrow">Creative Web Infotech</div>
                    <h1 id="application-title"><%= success ? 'Application received' : 'Internship Application' %></h1>
                    <p><%= success ? 'Thank you for taking the first step with us.' : 'Tell us a little about yourself and the role you are interested in.' %></p>
                </div>
            </header>

            <% if (success) { %>
                <div class="success-content" role="status">
                    <div class="success-icon"><i class="fas fa-check" aria-hidden="true"></i></div>
                    <h2>Submitted successfully</h2>
                    <p><% if (emailError) { %>Your internship application has been received, but we couldn't send the employee ID and secure document link to<% } else { %>Your internship application has been received. The employee ID and secure document link have been sent to<% } %> <strong><%= applicationEmail || '' %></strong>.</p>
                    <% if (applicationId) { %>
                        <div class="application-id">Application ID: <%= applicationId %></div>
                    <% } %>
                    <% if (emailError) { %>
                        <p class="form-alert" role="alert">Your application is saved, but we couldn't send the email. Please contact Creative Web Infotech and share your employee ID.</p>
                    <% } %>
                    <a href="/apply" class="success-button">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        Submit another application
                    </a>
                </div>
            <% } else { %>
                <div class="application-body">
                    <p class="form-intro">Complete the details below to apply. All fields are required.</p>

                    <% if (error) { %>
                        <div class="form-alert" role="alert">
                            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                            <span><%= error %></span>
                        </div>
                    <% } %>

                    <form action="/apply" method="POST">
                        <section class="form-section" aria-labelledby="personal-details-title">
                            <h2 class="section-heading" id="personal-details-title">
                                <span class="section-number">01</span>
                                Personal details
                            </h2>
                            <div class="field-grid">
                                <div class="field field-full">
                                    <label for="studentName">Full name <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-user" aria-hidden="true"></i>
                                        <input class="field-control" type="text" id="studentName" name="studentName"
                                            placeholder="Enter your full name"
                                            value="<%= applicationFormData.studentName || '' %>" required
                                            autocomplete="name">
                                    </div>
                                </div>

                                <div class="field">
                                    <label for="studentContactNo">Contact number <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-phone" aria-hidden="true"></i>
                                        <input class="field-control" type="tel" id="studentContactNo"
                                            name="studentContactNo" placeholder="10-digit mobile number"
                                            value="<%= applicationFormData.studentContactNo || '' %>" required
                                            pattern="[0-9]{10}" inputmode="numeric" autocomplete="tel"
                                            title="Enter a 10-digit contact number">
                                    </div>
                                </div>

                                <div class="field">
                                    <label for="collegeName">College name <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-building-columns" aria-hidden="true"></i>
                                        <input class="field-control" type="text" id="collegeName" name="collegeName"
                                            placeholder="Enter your college name"
                                            value="<%= applicationFormData.collegeName || '' %>" required>
                                    </div>
                                </div>

                                <div class="field">
                                    <label for="semesterCount">Number of semesters <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-graduation-cap" aria-hidden="true"></i>
                                        <input class="field-control" type="number" id="semesterCount" name="semesterCount"
                                            placeholder="e.g. 6" value="<%= applicationFormData.semesterCount || '' %>"
                                            min="1" max="12" step="1" required>
                                    </div>
                                </div>

                                <div class="field">
                                    <label for="studentEmail">Email address <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-envelope" aria-hidden="true"></i>
                                        <input class="field-control" type="email" id="studentEmail" name="studentEmail"
                                            placeholder="you@example.com"
                                            value="<%= applicationFormData.studentEmail || '' %>" required
                                            autocomplete="email">
                                    </div>
                                </div>

                                <div class="field field-full">
                                    <label for="collegeAddress">College address <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-location-dot" aria-hidden="true"></i>
                                        <textarea class="field-control" id="collegeAddress" name="collegeAddress"
                                            placeholder="Enter your college address" required><%= applicationFormData.collegeAddress || '' %></textarea>
                                    </div>
                                </div>

                                <div class="field field-full">
                                    <label for="address">Full address <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-location-dot" aria-hidden="true"></i>
                                        <textarea class="field-control" id="address" name="address"
                                            placeholder="Enter your current residential address"
                                            autocomplete="street-address" required><%= applicationFormData.address || '' %></textarea>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="form-section" aria-labelledby="preferences-title">
                            <h2 class="section-heading" id="preferences-title">
                                <span class="section-number">02</span>
                                Internship preferences
                            </h2>
                            <div class="field-grid">
                                <div class="field field-full">
                                    <label for="internshipPosition">Position / role <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-briefcase" aria-hidden="true"></i>
                                        <input class="field-control" type="text" id="internshipPosition"
                                            name="internshipPosition" placeholder="e.g. Web Developer Intern"
                                            value="<%= applicationFormData.internshipPosition || '' %>" required>
                                    </div>
                                </div>

                                <div class="field">
                                    <label for="startDate">Preferred joining date <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap">
                                        <i class="fas fa-calendar-days" aria-hidden="true"></i>
                                        <input class="field-control" type="date" id="startDate" name="startDate"
                                            value="<%= applicationFormData.startDate || '' %>" required>
                                    </div>
                                </div>

                                <div class="field">
                                    <label for="branch">Preferred branch <span class="required-mark" aria-hidden="true">*</span></label>
                                    <div class="input-wrap select-wrap">
                                        <i class="fas fa-code-branch" aria-hidden="true"></i>
                                        <select class="field-control" id="branch" name="branch" required>
                                            <option value="" disabled <%= applicationFormData.branch ? '' : 'selected' %>>
                                                Select a branch
                                            </option>
                                            <% branches.forEach(branch => { %>
                                                <option value="<%= branch %>"
                                                    <%= applicationFormData.branch === branch ? 'selected' : '' %>>
                                                    <%= branch.charAt(0).toUpperCase() + branch.slice(1) %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <div class="submit-area">
                            <div class="submit-note">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                                Your information is used only to process this application.
                            </div>
                            <button type="submit" class="submit-button">
                                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                                Submit application
                            </button>
                        </div>
                    </form>
                </div>
            <% } %>
        </section>
        <footer class="application-footer">
            &copy; <%= new Date().getFullYear() %> Creative Web Infotech. All rights reserved.
        </footer>
    </main>
    <script>
        const startDateInput = document.getElementById('startDate');
        if (startDateInput && !startDateInput.value) {
            const today = new Date();
            const localDate = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
                .toISOString()
                .slice(0, 10);
            startDateInput.value = localDate;
        }
    </script>
    <% if (success) { %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            Swal.fire({
                icon: <%- JSON.stringify(emailError ? 'warning' : 'success') %>,
                title: <%- JSON.stringify(emailError ? 'Application received, email not sent' : 'Application received') %>,
                text: <%- JSON.stringify(emailError
                    ? 'Your application was saved, but the employee email could not be sent. Please contact Creative Web Infotech.'
                    : 'The employee ID and secure document link were sent to the email address provided.') %>,
                confirmButtonText: 'OK'
            });
        </script>
    <% } %>
</body>

</html>
