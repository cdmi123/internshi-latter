<%
    const formatStudentLetterDate = (value) => {
        if (!value) return '________________';
        const parts = String(value).split('-');
        if (parts.length !== 3) return String(value);
        if (parts[0].length === 4) return `${parts[2]}-${parts[1]}-${parts[0]}`;
        return String(value);
    };
%>
<div class="page" data-document="loi-student">
    <div class="watermark"></div>
    <% if (showInternetCopyWatermark) { %><%- include('internet-copy-watermark') %><% } %>
    <header>
        <div class="logo-section">
            <img src="/logo.png" alt="Creative Web Infotech" class="company-logo">
        </div>
        <div class="contact-info">
            <p><i class="fa-solid fa-envelope"></i> info@creativewebinfotech.com</p>
            <p><i class="fa-solid fa-phone"></i> +91 <%= internship.facultyContactNo %></p>
            <p><i class="fa-solid fa-building"></i> UDYAM-GJ-22-0548946</p>
        </div>
    </header>

    <div class="yellow-divider"></div>
    <div class="loi-heading">
        <p>Annexure 2</p>
        <h2 class="document-title">Letter of Intent to the Student</h2>
    </div>

    <div class="loi-content">
        <p class="loi-date"><strong>Date: <%= formatStudentLetterDate(internship.date ? new Date(internship.date).toISOString().slice(0, 10) : '') %></strong></p>
        <p>To,</p>
        <p><strong><%= internship.studentName %></strong></p>
        <p><%= internship.collegeName || '' %></p>
        <p><%= internship.address %></p>
        <p>Mobile: +91 <%= internship.studentContactNo %></p>

        <p class="loi-salutation">Dear <strong><%= internship.studentName %></strong>,</p>
        <p>
            It gives us great pleasure to inform you that you have been selected by M/s
            <strong>Creative Web Infotech</strong> as a
            <strong><%= internship.internshipPosition %></strong> to be located at
            <strong>Surat, Gujarat</strong>. This is an unpaid internship; the stipend will be
            <strong>Rs. 0 (Zero) per month</strong>.
        </p>

        <p class="loi-closing">Yours sincerely,</p>
        <div class="loi-authorized-signatory">
            <div class="loi-signature-line"></div>
            <p><strong>Creative Web Infotech</strong></p>
            <p>Authorized Signatory</p>
            <p>(Seal of the company)</p>
        </div>

        <div class="loi-declaration">
            <h3>Student declaration and acceptance of offer:</h3>
            <p>
                I have read the terms and conditions and information regarding my OJT / internship / Apprenticeship
                offer letter. I affirm that I accept the offer and will join the above-mentioned company on the said
                date.
            </p>
        </div>
    </div>

    <div class="signatures loi-student-signatures">
        <div class="sign-box">
            <div class="line"></div>
            <p><strong>Student Signature</strong></p>
        </div>
        <div class="sign-box">
            <div class="line"></div>
            <p><strong>Date</strong></p>
        </div>
    </div>

    <footer class="page-footer">
        <p><%= getBranchAddress(internship.branch) %></p>
        <p>https://www.creativewebinfotech.com/ | info@creativewebinfotech.com</p>
    </footer>
</div>
