<% const isVerificationMode = typeof verificationMode !== 'undefined' && verificationMode; %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isVerificationMode ? 'Verified Offer Letter' : 'Internship Offer Letter' %></title>

    <link rel="stylesheet" href="/css/latter.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            html,
            body {
                width: 210mm;
                min-height: 0;
                margin: 0;
                padding: 0;
                background: #fff;
            }

            .page {
                box-sizing: border-box;
                width: 210mm;
                height: 297mm;
                margin: 0;
                overflow: hidden;
                break-inside: avoid-page;
                page-break-inside: avoid;
                break-after: avoid-page;
                page-break-after: avoid;
            }
        }
    </style>
    <% if (isVerificationMode) { %>
        <style>
            body.verification-mode {
                background: #e9eef5;
            }

            body.verification-away {
                visibility: hidden !important;
            }

            .verification-banner {
                position: relative;
                z-index: 3;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                width: min(210mm, calc(100% - 32px));
                margin: 20px auto;
                padding: 16px 22px;
                border-radius: 12px;
                background: #fff;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.14);
            }

            .verification-brand {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .verification-brand img {
                width: 150px;
                height: auto;
            }

            .verification-brand h1 {
                margin: 0 0 4px;
                color: #17365d;
                font-size: 18px;
            }

            .verification-brand p {
                margin: 0;
                color: #526174;
                font-size: 13px;
            }

            .verification-back {
                padding: 10px 16px;
                border-radius: 7px;
                background: #17365d;
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
            }

            .page.verification-page::after {
                content: 'VERIFIED';
                position: absolute;
                top: 50%;
                left: 50%;
                z-index: 3;
                color: rgba(23, 54, 93, 0.12);
                font-size: 68px;
                font-weight: 800;
                letter-spacing: 8px;
                white-space: nowrap;
                transform: translate(-50%, -50%) rotate(-35deg);
                pointer-events: none;
                user-select: none;
            }

            @media print {
                body.verification-mode {
                    display: none !important;
                }
            }
        </style>
    <% } %>
</head>

<body class="<%= isVerificationMode ? 'verification-mode' : '' %>">
    <% if (isVerificationMode) { %>
        <div class="verification-banner">
            <div class="verification-brand">
                <img src="/logo.png" alt="Creative Web Infotech">
                <div>
                    <h1>Document Verification</h1>
                    <p>Verified offer letter for Employee ID: <strong><%= internship.idno %></strong></p>
                </div>
            </div>
            <a class="verification-back" href="/verify">Verify another ID</a>
        </div>
    <% } %>

    <div class="page<%= isVerificationMode ? ' verification-page' : '' %>">

        <!-- Watermark -->
        <div class="watermark"></div>
        <% if (typeof internetCopyWatermark !== 'undefined' && internetCopyWatermark) { %>
            <%- include('partials/internet-copy-watermark') %>
        <% } %>

        <!-- Header -->
        <header>
            <div class="logo-section">
                <img src="/logo.png" alt="Creative Web Infotech" class="company-logo">
            </div>

            <div class="contact-info">
                <p><i class="fa-solid fa-envelope"></i> info@creativewebinfotech.com</p>
                <p><i class="fa-solid fa-phone"></i> +91 <%- internship.facultyContactNo.slice(0,5) + ' ' +
                        internship.facultyContactNo.slice(5) %></p>
                <p><i class="fa-solid fa-building"></i> UDYAM-GJ-22-0548946</p>
            </div>
        </header>

        <div class="yellow-divider"></div>

        <h2 class="document-title">INTERNSHIP OFFER LETTER</h2>

        <div class="date-section document-meta">
            <p><strong>ID : <%= internship.idno || 'N/A' %></strong></p>
            <p>
                <strong>
                    Date :
                    <%= new Date(internship.date).getDate().toString().padStart(2, '0' ) %>-
                        <%= (new Date(internship.date).getMonth() + 1).toString().padStart(2, '0' ) %>-
                            <%= new Date(internship.date).getFullYear() %>
                </strong>
            </p>
        </div>

        <div class="recipient-details">
            <p><strong>To,</strong></p>
            <p><strong><%- internship.studentName %></strong></p>
            <p><%- internship.collegeName %></p>

            <p>
                <strong>Address :</strong>
                <%- internship.address %>
            </p>

            <p>
                <strong>Mob no :</strong>
                +91 <%- internship.studentContactNo.slice(0,5) + ' ' + internship.studentContactNo.slice(5) %>
            </p>
        </div>

        <div class="letter-body">
            <p>
                <strong>Dear <%- internship.studentName %>,</strong>
            </p>

            <p>
                It gives me great pleasure to inform you that
                <strong>Creative Web Infotech</strong>
                has join you as an
                <strong><%- internship.internshipPosition %></strong>
                to be based in Surat.

                This is non-payable internship, so no stipend will be provided during the internship period.
            </p>
        </div>

        <div class="internship-details">

            <p>
                <strong>Details of the Internship are as follow:</strong>
            </p>

            <table>
                <tr>
                    <td><strong>Internship Position</strong></td>
                    <td>: <%- internship.internshipPosition %></td>
                </tr>

                <tr>
                    <td><strong>Duration</strong></td>
                    <td>: <%- internship.duration %></td>
                </tr>

                <tr>
                    <td><strong>Starting Date</strong></td>
                    <td>
                        :
                        <%= internship.startDate ? (internship.startDate.split('-')[0].length===4 ?
                            internship.startDate.split('-').reverse().join('-') : internship.startDate) : 'N/A' %>
                    </td>
                </tr>

                <tr>
                    <td><strong>Working Time</strong></td>
                    <td>: <%- internship.workingTime %></td>
                </tr>

                <tr>
                    <td><strong>Reporting to</strong></td>
                    <td>: <%- internship.internFacultyName %></td>
                </tr>
            </table>
        </div>

        <div class="declaration">
            <p><strong>Employee declaration and acceptance of offer:</strong></p>

            <p>
                I have read the terms and conditions and information regarding my internship offer letter.
                I affirm that I accept the offer and will join the above-mentioned company on said date.
            </p>
        </div>

        <!-- Footer -->
        <footer>

            <div class="signatures">
                <div class="sign-box">
                    <div class="line"></div>
                    <p><strong>Intern Sign</strong></p>
                </div>

                <div class="sign-box">
                    <div class="line"></div>
                    <p><strong>Creative Web Infotech</strong></p>
                </div>
            </div>

            <div class="footer-line"></div>

            <p>
                401, 4th Floor, City Center Complex, Nr. Yogichowk, Varachha,
            </p>

            <p>
                Surat,Gujarat INDIA - 395006 |
                https://www.creativewebinfotech.com/
            </p>

        </footer>

    </div>

    <% if (isVerificationMode) { %>
        <script src="/js/verification-guard.js"></script>
    <% } %>

</body>

</html>